# ASMR Media Manager 环境变量配置
# 复制此文件为 .env 并根据实际情况修改

# ===== 应用 =====
APP_ENV=development
DEBUG=true

# ===== 数据库 =====
# 默认使用 backend/data/asmr_manager.db，无需设置 DATABASE_URL。
# 若需覆盖，请使用当前运行环境中可写的 SQLite 绝对路径；Docker Compose 已自动配置。

# ===== 目录 =====
DOWNLOAD_DIR=./media/downloads
LIBRARY_DIR=./media/library
WATCH_DIRS=[]                        # 额外监控目录，JSON 数组，如 ["/media/extra1","/media/extra2"]

# ===== 扫描 =====
WATCH_ENABLED=true                   # 启用目录监控
WATCH_AUTO_ORGANIZE=true             # 监控到新文件后自动整理到 library 目录
SCAN_RECURSIVE=true                  # 扫描时递归子目录
STABLE_SECONDS=10                    # 文件大小稳定多少秒后判定下载完成
CHECK_INTERVAL=5                     # 检查间隔（秒）

# ===== 服务器 =====
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# ===== DLsite =====
DLSITE_ENABLED=true                  # 启用 DLsite API（根据 RJ 号自动获取元数据）
DLSITE_API_BASE=https://www.dlsite.com/maniax/api
DLSITE_CACHE_TTL=1800                # 缓存时间（秒）
DLSITE_RATE_LIMIT=1.0                # 每秒最大请求数
DLSITE_TIMEOUT=10.0                  # 请求超时（秒）
DLSITE_PROXY=                        # HTTP 代理，如 http://127.0.0.1:7890（大陆用户需要）

# ===== Plex =====
PLEX_URL=                            # Plex Server 地址，如 http://192.168.1.100:32400
PLEX_TOKEN=                          # Plex X-Plex-Token
PLEX_AUTO_REFRESH=true               # 整理文件后自动通知 Plex 刷新媒体库

# ===== AI（可选）=====
AI_ENABLED=false
AI_API_URL=                          # OpenAI 兼容 API 地址，如 https://api.openai.com/v1
AI_API_KEY=                          # API 密钥
AI_MODEL=                            # 模型名，如 gpt-4o-mini、deepseek-chat
OCR_ENABLED=false

# ===== 重命名 =====
AUDIO_RENAME_PATTERN=[{cv}] {title} ({rj_id})
VIDEO_RENAME_PATTERN=[{creator}] {title}
MAX_FILENAME_LENGTH=200

# ===== 封面 =====
COVER_FILENAMES=["cover.jpg","folder.jpg","front.jpg"]
COVER_MAX_SIZE=1000

# ===== 日志 =====
LOG_LEVEL=INFO
